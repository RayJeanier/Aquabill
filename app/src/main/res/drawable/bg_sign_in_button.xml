<?xml version="1.0" encoding="utf-8"?>
<!-- Sign In button, same as the website: brand gradient, 12dp corners -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/brand_teal"
                android:startColor="@color/brand_blue" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
